# 应用
APP_NAME=RAG 企业知识库
APP_SLUG=rag-enterprise-knowledge-base
APP_ENV=development
DEBUG=true
APP_SECRET_KEY=请替换为随机生成的密钥
API_V1_PREFIX=/api/v1

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=请替换为数据库密码
POSTGRES_DB=rag_kb

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=rag_minio
MINIO_SECRET_KEY=请替换为MinIO密码
MINIO_SECURE=false
MINIO_BUCKET_DOCUMENTS=documents

# Milvus
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION_PREFIX=rag_kb

# Unstructured 文档解析服务
UNSTRUCTURED_API_URL=http://127.0.0.1:8001

# 大模型
RAG_LLM_BASE_URL=https://api.deepseek.com
RAG_LLM_MODEL=deepseek-chat
RAG_LLM_API_KEY=

# 联网搜索
TAVILY_API_KEY=

# 本地向量与重排模型
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
MODEL_LOCAL_FILES_ONLY=true

# 语义分块 embedding（默认不改变现有 BGE 行为）
RAG_SEMANTIC_EMBEDDING_PROVIDER=bge
RAG_SEMANTIC_OPENAI_THRESHOLD=5000
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_API_KEY=

# 文件限制
MAX_UPLOAD_SIZE_MB=100
