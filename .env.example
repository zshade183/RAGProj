# 应用
APP_NAME=RAG 企业知识库
APP_SLUG=rag-enterprise-knowledge-base
APP_ENV=development
DEBUG=true
APP_SECRET_KEY=请替换为随机生成的密钥
API_V1_PREFIX=/api/v1

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=请替换为数据库密码
POSTGRES_DB=rag_kb

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=rag_minio
MINIO_SECRET_KEY=请替换为MinIO密码
MINIO_SECURE=false
MINIO_BUCKET_DOCUMENTS=documents

# Milvus
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION_PREFIX=rag_kb

# Unstructured 文档解析服务
UNSTRUCTURED_API_URL=http://127.0.0.1:8001/general/v0/general

# 大模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 联网搜索
TAVILY_API_KEY=

# 本地向量与重排模型
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cuda
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda

# 文件限制
MAX_UPLOAD_SIZE_MB=100